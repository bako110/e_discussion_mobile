<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Scanner QR + prise de photo/vidéo pour stories, groupes et avatars -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Enregistrement des notes vocales (stories audio) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Lecture galerie (Android 12-) / Android 13+ utilise le sélecteur système -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Synchro du carnet d'adresses : retrouver les contacts qui utilisent l'app -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Partage de position dans une conversation -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Appels WebRTC (LiveKit self-hosted) : audio full-duplex + réseau + service au premier plan -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Service de fond persistant : garde le processus JS (donc la
         connexion WebSocket / le traitement des push FCM) vivant plus
         longtemps sur les OEM agressifs (Transsion/Infinix/Tecno) qui tuent
         sinon l'app quelques secondes après son passage en arrière-plan.
         Type `dataSync` : le plus proche de notre usage réel (synchro
         messages), seul type autorisé sans dépendance à un matériel
         particulier (micro/caméra/localisation). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Sonnerie d'appel entrant en plein écran (Android 14+) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Exemption Doze/optimisation batterie : sans elle, certains OEM (Transsion/
         Infinix/Tecno notamment) coupent silencieusement la connexion FCM en
         arrière-plan -> aucun push ne parvient jamais à l'appareil, même si le
         serveur l'envoie avec succès. Permet à l'app de proposer explicitement
         à l'utilisateur d'ajouter Gofolyx à la liste blanche des optimisations
         batterie (voir pushTokenService.ts / requestIgnoreBatteryOptimizations). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/SplashTheme"
        android:showWhenLocked="true"
        android:turnScreenOn="true"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- Deep link : gofolyx://join/<invite_code> (QR / lien d'invitation) -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="gofolyx" android:host="join" />
        </intent-filter>
      </activity>

      <!-- Service de fond persistant (voir BackgroundKeepAliveService) — pas
           exporté, usage interne uniquement. -->
      <service
        android:name=".BackgroundKeepAliveService"
        android:enabled="true"
        android:exported="false"
        android:foregroundServiceType="dataSync" />
    </application>
</manifest>
